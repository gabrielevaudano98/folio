{
  "name": "folio",
  "version": "1.5.1",
  "description": "A Markdown editor your AI assistants can read and edit through MCP.",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "dist:linux": "node build.mjs && electron-builder --linux",
    "dist:win": "node build.mjs && electron-builder --win",
    "test:mcp": "node build.mjs && node test/mcp.test.mjs",
    "test": "node build.mjs && node test/run.mjs",
    "dist:win:linux": "node build.mjs && electron-builder --win portable --x64 -c.win.signAndEditExecutable=false"
  },
  "author": {
    "name": "Gabriele Vaudano",
    "url": "https://github.com/gabrielevaudano98"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@joplin/turndown-plugin-gfm": "^1.0.71",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-bubble-menu": "^3.34.0",
    "@tiptap/extension-code-block": "^3.34.0",
    "@tiptap/extension-details": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-subscript": "^3.34.0",
    "@tiptap/extension-superscript": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/extension-typography": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "axe-core": "^4.14.1",
    "chokidar": "^6.0.0",
    "chrono-node": "^2.10.3",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "docx": "^9.16.0",
    "dompurify": "^3.5.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "gemoji": "^8.1.0",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.12.0",
    "hot-formula-parser": "^4.0.0",
    "i18next": "^27.2.2",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-static": "^1.76.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.3.0",
    "moveable": "^0.53.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "pptxgenjs": "^4.0.1",
    "pptxtojson": "^3.0.0",
    "qrcode-generator": "^1.5.2",
    "selecto": "^1.26.3",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "productName": "Folio",
  "type": "module",
  "build": {
    "appId": "com.folio.markdown",
    "productName": "Folio",
    "copyright": "Copyright (C) 2026 Gabriele Vaudano. AGPL-3.0. Based on Folio by Gabriele Vaudano.",
    "publish": [
      {
        "provider": "github",
        "owner": "gabrielevaudano98",
        "repo": "folio",
        "releaseType": "prerelease"
      }
    ],
    "afterPack": "build/afterPack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/mcp-stdio.mjs"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown document",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Folio uses the microphone only when you record narration for a slide show."
      }
    },
    "dmg": {
      "title": "Folio",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Folio-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Folio-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "folio",
      "synopsis": "Markdown editor for AI assistants",
      "artifactName": "Folio-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      }
    ]
  },
  "homepage": "https://github.com/gabrielevaudano98/folio",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielevaudano98/folio.git"
  },
  "bugs": {
    "url": "https://github.com/gabrielevaudano98/folio/issues"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.1.0"
    },
    "minimatch@>=7 <11": "^11.0.1",
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    }
  }
}
